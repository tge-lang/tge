if test "${GCC}" = "yes"; then
   CFLAGS="${CFLAGS}${CFLAGS+ }-DTGE_VISIBLE='[[[gnu::visibility (\"default\")]]]'"
else
   CFLAGS="${CFLAGS}${CFLAGS+ }-DTGE_VISIBLE=''"
fi
INDENT_FLAGS="${INDENT_FLAGS}${INDENT_FLAGS+ }-TTGE_VISIBLE"
for attribute in pure const; do
    _attr=`echo ${attribute} | tr '[[:lower:]]' '[[:upper:]]'`
    if test "${GCC}" = "yes"; then
       _attr2="[[[gnu::${attribute}]]]"
    else
       _attr2=""
    fi
    CFLAGS="${CFLAGS}${CFLAGS+ }-DTGE_${_attr}='${_attr2}'"
    INDENT_FLAGS="${INDENT_FLAGS}${INDENT_FLAGS+ }-TTGE_${_attr}"
done
for attribute in noreturn nodiscard unsequenced; do
    _attr=`echo ${attribute} | tr '[[:lower:]]' '[[:upper:]]'`
    if test "${attribute}" = "nodiscard" -a "${GCC}" = "yes"; then
       _attr2="gnu::warn_unused_result"
    else
       _attr2="${attribute}"
    fi    
    CFLAGS="${CFLAGS}${CFLAGS+ }-DTGE_${_attr}='[[[${_attr2}]]]'"
    INDENT_FLAGS="${INDENT_FLAGS}${INDENT_FLAGS+ }-TTGE_${_attr}"
done
