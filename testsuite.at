AT_INIT
AT_COPYRIGHT([Copyright © 2026 Barry Schwartz])

#---------------------------------------------------------------------

AT_SETUP([defer])
AT_KEYWORDS([defer cleanup c2y c29])
AT_CHECK(["${abs_builddir}"/test_defer],[0])
AT_CLEANUP

AT_SETUP([spookyhash])
AT_KEYWORDS([spookyhash hash hashtable hashmap container])
AT_CHECK(["${abs_builddir}"/test_spookyhash],[0])
AT_CLEANUP

AT_SETUP([tge_gc])
AT_KEYWORDS([tge_gc gc garbage collector])
AT_CHECK(["${abs_builddir}"/test_tge_gc],[0],[ignore])
AT_CLEANUP

AT_SETUP([tge_strings])
AT_KEYWORDS([tge_strings utf32 utf8 utf-32 utf-8
                         strings string unicode])
AT_CHECK(["${abs_builddir}"/test_tge_strings],[0])
AT_CLEANUP

