.PHONY: indent
indent:
	$(INDENT) -l72 --no-tabs \
		-Tint8_t \
		-Tint16_t \
		-Tint32_t \
		-Tint64_t \
		-Tuint8_t \
		-Tuint16_t \
		-Tuint32_t \
		-Tuint64_t \
		-Tchar32_t \
		-Tutf8_t \
		-Tutf32_t \
		-TFILE \
		$(srcdir)/*.{c,h}
