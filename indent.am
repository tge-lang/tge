.PHONY: indent
indent:
	for f in $(addprefix $(srcdir)/,$(libtge_la_SOURCES)) \
				$(addprefix $(srcdir)/,$(CHECK_PROGRAM_SRC)); do \
	  if $(UNCRUSTIFY) -q -c $(srcdir)/uncrustify.cfg $${f} -l c; then \
        mv $${f}{.uncrustify,}; \
	  else \
	    rm -f $${f}.uncrustify; \
	  fi; \
	done

