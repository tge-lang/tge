.PHONY: indent
indent:
	$(INDENT) -l72 --no-tabs \
		-Tutf8_t \
		-Tutf32_t \
		-TFILE \
		-Tthread_local \
		-Tallocation_header_t \
		-Tgarbage_collector_t \
		$(INDENT_FLAGS) \
		$(srcdir)/*.{c,h}
